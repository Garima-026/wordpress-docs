# Cloudflare Pages header rules. GitHub Pages ignores this file entirely —
# on the current host the same effect needs a Cloudflare Transform Rule.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Vary: Accept
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog", </llms.txt>; rel="service-doc"; type="text/markdown", </.well-known/ai-catalog.json>; rel="describedby"; type="application/json", </sitemap.xml>; rel="sitemap"

/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/.well-known/ai-catalog.json
  Content-Type: application/json

/robots.txt
  Content-Type: text/plain; charset=utf-8
